# Copy to .env and fill in values: cp .env.example .env
# Never commit .env. Variables marked (Fx.y) are first used in that feature.

# --- App ---
# development | production | test  (production disables /docs)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Local database (docker compose `db` service) (F0.3) ---
POSTGRES_USER=apexgpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apexgpt
POSTGRES_PORT=5432

# Backend connection strings (required). postgres:// and postgresql:// are
# accepted and normalised to the psycopg driver. Keep credentials in sync with
# the POSTGRES_* values above.
# Backend running on the host (uv run ...): via localhost and POSTGRES_PORT.
DATABASE_URL=postgresql://apexgpt:change-me@localhost:5432/apexgpt
# Backend running in docker compose: host `db`, container port 5432 (always).
COMPOSE_DATABASE_URL=postgresql://apexgpt:change-me@db:5432/apexgpt
# Production: Neon pooled connection string with ?sslmode=require (F7.2).
# Seconds to wait when connecting (1-60). Covers a Neon cold start.
DATABASE_CONNECT_TIMEOUT=10

# Ingestion (F1.2): raw downloads are cached here (git-ignored). Default: <repo>/data
# DATA_DIR=

# Wikipedia fetcher (F2.1) and article selection (F2.2, `narrative.select`).
# Wikimedia's User-Agent policy asks for a client name plus contact details
# (a URL or email); requests are refused without it, and generic agents get
# rate-limited (HTTP 429).
WIKI_USER_AGENT=apexgpt-fetcher/0.1 (https://github.com/<you>/apexgpt; <you>@example.com)
# Minimum seconds between API requests (0.1-60; requests are always serial).
WIKI_MIN_INTERVAL_SECONDS=1.0

# Read-only role used by the LLM stats tool (F1.5). The role (apexgpt_llm_reader)
# is created by migrations without a password; set one here (16+ characters),
# then enable login: cd backend && uv run python -m app.db.readonly_role
READONLY_DATABASE_URL=postgresql://apexgpt_llm_reader:change-me-readonly-pw@localhost:5432/apexgpt
# The same role from inside docker compose (host `db`, port 5432), for the
# backend container's stats tool (F3.5).
COMPOSE_READONLY_DATABASE_URL=postgresql://apexgpt_llm_reader:change-me-readonly-pw@db:5432/apexgpt

# Knowledge search (F3.1/F3.2): where the backend keeps its two models, the
# query embedder (bge-small, ~65 MB) and the reranker (MiniLM-L-6, ~80 MB), both
# downloaded on first search. This path is for running the backend on the host
# from backend/; it shares the embedder ingestion downloaded. docker compose
# mounts data/models and sets its own path. Blank = fastembed's default
# temporary directory (downloaded again after a reboot).
EMBEDDING_CACHE_DIR=../data/models
# Threads per model (1-16). Keep it at the backend's CPU limit: more threads
# than CPUs is much slower, not faster. On the host you can raise it.
ONNX_THREADS=1

# --- Backend (F0.2) ---
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins; '*' is rejected.
CORS_ORIGINS=http://localhost:3000
# IPs/CIDRs allowed to set X-Forwarded-For (the reverse proxy). Never '*'.
# Local: 127.0.0.1. Production: the Traefik/Coolify proxy network (F7.1).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Frontend (F0.4) ---
FRONTEND_PORT=3000
# Backend URL as seen from the BROWSER. Inlined at BUILD time (Docker build
# arg), so changing it requires a rebuild. The frontend's own origin must be
# listed in the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM providers, free tiers only (F3.3) ---
# Tried in this order; a blank key turns that provider off. Keys:
# console.groq.com, aistudio.google.com, openrouter.ai.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Models per provider (free-tier lists change; each default was checked with a
# live tool call, see app/llm/providers.py). A wrong model falls through.
LLM_GROQ_MODEL=openai/gpt-oss-120b
LLM_GEMINI_MODEL=gemini-3.1-flash-lite
LLM_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Seconds per attempt (1-120), and extra attempts on the same provider after a
# timeout, connection error or 5xx (0-3). Rate limits (429) fall back at once.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# If every provider is rate limited and the limit resets within this many
# seconds (0-60), wait once and retry. Groq's free tier counts tokens per
# minute, so a burst of questions can hit it. 0 = fail at once.
LLM_RATE_LIMIT_WAIT_SECONDS=20

# --- Chat API protection (F4.4) ---
# Per-IP limits: "N/period" joined by ";" (second, minute, hour, day). Blank =
# no limit. Chat answers spend free-tier LLM tokens, so keep its limit tight.
RATE_LIMIT_CHAT=6/minute;100/day
RATE_LIMIT_FEEDBACK=30/minute;500/day
# In-memory cache of complete answers for repeated questions: entries
# (0-10000, 0 = off) and seconds each is kept (60-604800).
ANSWER_CACHE_SIZE=256
ANSWER_CACHE_TTL_SECONDS=86400

# --- Logging (F4.5) ---
# JSON-lines log file, rotated by size (MB per file 1-100, backups 1-20).
# Blank = console only. Docker compose sets it to /app/logs/apexgpt.log
# (data/logs/ on the host). Holds questions; no IP addresses.
LOG_FILE=
LOG_FILE_MAX_MB=10
LOG_FILE_BACKUPS=5
