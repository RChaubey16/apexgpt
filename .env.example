# Copy to .env and fill in values: cp .env.example .env
# Never commit .env. Variables marked (Fx.y) are first used in that feature.

# --- App ---
# development | production | test  (production disables /docs)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Local database (docker compose `db` service) (F0.3) ---
POSTGRES_USER=apexgpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apexgpt
POSTGRES_PORT=5432

# Backend connection strings (required). postgres:// and postgresql:// are
# accepted and normalised to the psycopg driver. Keep credentials in sync with
# the POSTGRES_* values above.
# Backend running on the host (uv run ...): via localhost and POSTGRES_PORT.
DATABASE_URL=postgresql://apexgpt:change-me@localhost:5432/apexgpt
# Backend running in docker compose: host `db`, container port 5432 (always).
COMPOSE_DATABASE_URL=postgresql://apexgpt:change-me@db:5432/apexgpt
# Production: Neon pooled connection string with ?sslmode=require (F7.2).
# Seconds to wait when connecting (1-60). Covers a Neon cold start.
DATABASE_CONNECT_TIMEOUT=10

# Ingestion (F1.2): raw downloads are cached here (git-ignored). Default: <repo>/data
# DATA_DIR=

# Wikipedia fetcher (F2.1) and article selection (F2.2, `narrative.select`).
# Wikimedia's User-Agent policy asks for a client name plus contact details
# (a URL or email); requests are refused without it, and generic agents get
# rate-limited (HTTP 429).
WIKI_USER_AGENT=apexgpt-fetcher/0.1 (https://github.com/<you>/apexgpt; <you>@example.com)
# Minimum seconds between API requests (0.1-60; requests are always serial).
WIKI_MIN_INTERVAL_SECONDS=1.0

# Read-only role used by the LLM stats tool (F1.5). The role (apexgpt_llm_reader)
# is created by migrations without a password; set one here (16+ characters),
# then enable login: cd backend && uv run python -m app.db.readonly_role
READONLY_DATABASE_URL=postgresql://apexgpt_llm_reader:change-me-readonly-pw@localhost:5432/apexgpt

# --- Backend (F0.2) ---
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins; '*' is rejected.
CORS_ORIGINS=http://localhost:3000
# IPs/CIDRs allowed to set X-Forwarded-For (the reverse proxy). Never '*'.
# Local: 127.0.0.1. Production: the Traefik/Coolify proxy network (F7.1).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Frontend (F0.4) ---
FRONTEND_PORT=3000
# Backend URL as seen from the BROWSER. Inlined at BUILD time (Docker build
# arg), so changing it requires a rebuild. The frontend's own origin must be
# listed in the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM providers, free tiers only (F3.3) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
