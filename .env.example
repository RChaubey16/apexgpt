# Copy to .env and fill in values: cp .env.example .env
# Never commit .env. Variables marked (Fx.y) are first used in that feature.

# --- App ---
# development | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Local database (docker compose `db` service) (F0.3) ---
POSTGRES_USER=apexgpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apexgpt
POSTGRES_PORT=5432

# Backend connection string.
# Local:      postgresql+psycopg://apexgpt:change-me@db:5432/apexgpt
# Production: Neon pooled connection string (F7.2)
DATABASE_URL=postgresql+psycopg://apexgpt:change-me@db:5432/apexgpt

# Read-only role used by the LLM stats tool (F1.5)
READONLY_DATABASE_URL=

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend (F0.4) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM providers, free tiers only (F3.3) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
